# Over the cable a computer gets the libraries by MTP. ROCKNIX's usbgadget starts
# umtprd with /etc/umtprd/umtprd.conf, which lists /storage/roms, so isoPod's covers it,
# before 081-usbgadget starts the gadget in the mode ROCKNIX remembers.
mkdir -p /storage/music /storage/videos /storage/books /storage/.update
grep -qs " /etc/umtprd/umtprd.conf " /proc/mounts ||
  mount --bind /usr/share/isopod/umtprd.conf /etc/umtprd/umtprd.conf

# That mode is file transfer, every boot. In ROCKNIX's "disabled" the port is a USB host
# and puts 5 V on the cable: a computer plugged in then charges from isoPod and sees no
# device. A file named usb-network in the update folder, which the cable reaches, asks for
# ROCKNIX's network mode instead, for SSH at 169.254.170.2 where there is no Wi-Fi.
MODE=mtp
[ -e /storage/.update/usb-network ] && MODE=cdc
mkdir -p /storage/.cache/usbgadget
echo "USB_MODE=${MODE}" >/storage/.cache/usbgadget/usbgadget.conf
