# Runs after 111-sway-init has rewritten the sway config: add isoPod's window
# rules, for when sway is started again, and make the shell the UI that autostart
# launches. 000-isopod-ui has started both by now.

SWAY_CONFIG=/storage/.config/sway/config
if [ -f "${SWAY_CONFIG}" ] && ! grep -q "/usr/share/isopod/sway.conf" "${SWAY_CONFIG}"; then
  echo "include /usr/share/isopod/sway.conf" >>"${SWAY_CONFIG}"
fi

mkdir -p /storage/.config/profile.d
echo 'UI_SERVICE="sway.service isopod-shell.service"' >/storage/.config/profile.d/099-isopod

# Only EmulationStation ever chose a time zone; isoPod speaks Korean first, so start in Seoul.
if [ ! -f /storage/.cache/timezone ]; then
  echo "TIMEZONE=Asia/Seoul" >/storage/.cache/timezone
  ln -sf /usr/share/zoneinfo/Asia/Seoul /var/run/localtime
fi

# 1 GB fills up once apps wait in the background: compress idle pages instead of
# losing apps, and skip KSM, which wakes the CPU twice a second for nothing here.
if [ ! -f /storage/.config/swap.conf ]; then
  printf 'ZRAM_SIZE="512"\nKSM_ENABLE="disable"\n' >/storage/.config/swap.conf
  systemctl reload rocknix-memory-manager
fi

# A Mac leaves a "._name" beside each file it copies to a card; those are not songs.
[ -e /storage/music/.mpdignore ] || echo '._*' >/storage/music/.mpdignore

# sshd takes keys alone and waits for one (sshd.socket.d, sshd@.service.d): a computer's public
# key comes over the cable, as a file named authorized_keys in the update folder, and is
# taken from there if it holds a key.
if ssh-keygen -l -f /storage/.update/authorized_keys >/dev/null 2>&1; then
  mkdir -p /storage/.ssh
  mv /storage/.update/authorized_keys /storage/.ssh/authorized_keys
  chmod 600 /storage/.ssh/authorized_keys
fi

# ROCKNIX's 099-networkservices starts sshd and then, moving on to fstrim, which names no
# condition file of its own, takes sshd's away again, so the unit is skipped at every boot.
. /etc/profile.d/001-functions
if [ "$(get_setting ssh.enabled)" = "1" ]; then
  mkdir -p /storage/.cache/services
  touch /storage/.cache/services/sshd.conf
  systemctl start --no-block sshd
fi
