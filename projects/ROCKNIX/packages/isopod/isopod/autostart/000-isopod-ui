# The UI starts here and the rest of ROCKNIX's boot scripts run behind it. Started after
# all of them, as ROCKNIX starts its own, it was on the screen some three seconds later.
# Sway wants its config written first, which is 111-sway-init's work; that script runs
# again in its turn, and 112-isopod adds isoPod's part to the fresh file once more.
/usr/lib/autostart/common/111-sway-init >/dev/null 2>&1
SWAY_CONFIG=/storage/.config/sway/config
grep -qs "/usr/share/isopod/sway.conf" "${SWAY_CONFIG}" ||
  echo "include /usr/share/isopod/sway.conf" >>"${SWAY_CONFIG}"

# Media lives in /storage; a second microSD card, which a computer can read, shows up
# inside each library as its own folder.
CARD=/storage/games-external
for KIND in music videos books audiobooks; do
  mkdir -p "/storage/${KIND}"
  LINK="/storage/${KIND}/SD Card"
  if grep -qs " ${CARD} " /proc/mounts && mkdir -p "${CARD}/${KIND}" 2>/dev/null; then
    [ -L "${LINK}" ] || ln -sfn "${CARD}/${KIND}" "${LINK}"
  elif [ -L "${LINK}" ]; then
    rm -f "${LINK}"
  fi
done

# MPD is running by now and watches the folders it found when it started, which was
# before the card was mounted. Started again it follows the card as well: a song copied
# there, over the cable or any other way, is in the library without a scan being asked for.
[ -d "/storage/music/SD Card/" ] && systemctl restart --no-block mpd

systemctl start --no-block sway.service isopod-shell.service
